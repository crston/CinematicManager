{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinematicmanager.local/schema/cinematic-v1.json",
  "title": "CinematicManager AI cinematic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "origin": { "$ref": "#/$defs/location" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "paths": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/pathPoint" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "x", "y", "z"],
      "properties": {
        "world": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" }
      }
    },
    "pathPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "world": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "yaw": { "type": "number" },
        "pitch": { "type": "number" }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "entityType", "name"],
          "properties": {
            "provider": { "const": "vanilla" },
            "entityType": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "skin": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id"],
          "properties": {
            "provider": { "enum": ["mythicmobs", "modelengine"] },
            "id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "speaker": { "type": "string" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "actionBase": {
      "type": "object",
      "required": ["tick", "type"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "type": { "type": "string" }
      }
    },
    "action": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            {
              "properties": {
                "type": { "const": "spawn_npc" },
                "actorId": { "$ref": "#/$defs/id" },
                "source": { "$ref": "#/$defs/source" },
                "location": { "$ref": "#/$defs/location" }
              },
              "required": ["actorId", "source", "location"]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            {
              "properties": {
                "type": { "const": "move_npc" },
                "actorId": { "$ref": "#/$defs/id" },
                "pathId": { "$ref": "#/$defs/id" },
                "origin": { "$ref": "#/$defs/location" }
              },
              "required": ["actorId", "pathId", "origin"]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            {
              "properties": {
                "type": { "const": "camera" },
                "mode": { "enum": ["static", "path"] },
                "location": { "$ref": "#/$defs/location" },
                "pathId": { "$ref": "#/$defs/id" },
                "origin": { "$ref": "#/$defs/location" }
              },
              "required": ["mode"],
              "allOf": [
                { "if": { "properties": { "mode": { "const": "static" } } }, "then": { "required": ["location"] } },
                { "if": { "properties": { "mode": { "const": "path" } } }, "then": { "required": ["pathId", "origin"] } }
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "sound" }, "sound": { "type": "string", "minLength": 1 } }, "required": ["sound"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "particle" }, "particle": { "type": "string" }, "location": { "$ref": "#/$defs/location" } }, "required": ["particle", "location"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "title" }, "title": { "type": "string" }, "subtitle": { "type": "string" } }, "required": ["title"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "message" }, "text": { "type": "string", "minLength": 1 } }, "required": ["text"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "command" }, "executor": { "enum": ["player", "console"] }, "command": { "type": "string", "minLength": 1 } }, "required": ["executor", "command"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "enum": ["hide_entity"] }, "actorId": { "$ref": "#/$defs/id" } }, "required": ["actorId"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "show_entity" }, "actorId": { "$ref": "#/$defs/id" }, "location": { "$ref": "#/$defs/location" } }, "required": ["actorId", "location"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "animation" }, "actorId": { "$ref": "#/$defs/id" }, "animation": { "type": "string", "minLength": 1 } }, "required": ["actorId", "animation"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "lightning" }, "location": { "$ref": "#/$defs/location" } }, "required": ["location"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "dialogue" }, "displayMode": { "enum": ["default", "title", "actionbar", "both", "betterhud", "bossbar"] }, "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } } }, "required": ["pages"] }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/actionBase" },
            { "properties": { "type": { "const": "wait" }, "displayMode": { "enum": ["default", "title", "actionbar", "both", "betterhud", "bossbar"] }, "prompt": { "type": "string", "minLength": 1 } }, "required": ["prompt"] }
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
